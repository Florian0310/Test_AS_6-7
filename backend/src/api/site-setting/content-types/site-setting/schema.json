{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Seiteneinstellungen",
    "description": "Zentrale Inhalte fuer Startseite und Kontakt"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "companyName": {
      "type": "string",
      "description": "Firmenname"
    },
    "address": {
      "type": "text",
      "description": "Adresse"
    },
    "email": {
      "type": "email",
      "description": "Kontakt E-Mail"
    },
    "phone": {
      "type": "string",
      "description": "Telefonnummer"
    },
    "openingHours": {
      "type": "richtext",
      "description": "Oeffnungszeiten"
    },
    "heroHeadline": {
      "type": "string",
      "description": "Startseiten-Headline"
    },
    "heroText": {
      "type": "text",
      "description": "Startseiten-Text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Startseiten-Bild"
    },
    "socials": {
      "type": "json",
      "description": "Social-Media Links"
    },
    "legal": {
      "type": "component",
      "repeatable": false,
      "component": "shared.legal"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "tools",
  "info": {
    "singularName": "tool",
    "pluralName": "tools",
    "displayName": "Werkzeug",
    "description": "Werkzeuge fuer den Verleih"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "description": "Name des Werkzeugs"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true,
      "description": "SEO-freundlicher URL-Slug"
    },
    "shortDescription": {
      "type": "string",
      "description": "Kurzbeschreibung fuer Listenansichten"
    },
    "description": {
      "type": "richtext",
      "description": "Detailbeschreibung"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "tools",
      "description": "Zugehoerige Kategorie"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ],
      "description": "Produktbilder"
    },
    "dailyPrice": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "description": "Mietpreis pro Tag"
    },
    "deposit": {
      "type": "decimal",
      "min": 0,
      "description": "Optionale Kaution"
    },
    "quantityTotal": {
      "type": "integer",
      "required": true,
      "min": 0,
      "description": "Gesamter Bestand"
    },
    "quantityAvailable": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 0,
      "description": "Fallback-Bestand; Verfuegbarkeit wird serverseitig berechnet"
    },
    "location": {
      "type": "string",
      "description": "Standort oder Abholort"
    },
    "tags": {
      "type": "json",
      "description": "Optionale Tag-Liste"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Nur aktive Werkzeuge sind oeffentlich sichtbar"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}

{
  "name": "allessaniert-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Payload CMS Backend fuer Alles Saniert Werkzeugverleih",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:importmap",
    "dev": "next dev -p 3001 --hostname 127.0.0.1 --webpack",
    "prebuild": "npm run generate:importmap",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:fresh": "payload migrate:fresh",
    "seed": "tsx src/seed/runSeed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:create": "payload migrate:create",
    "postbuild": "node scripts/package.mjs"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "dotenv": "^16.4.5",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "payload": "3.92.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.5",
    "slugify": "^1.6.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "next": "16.4.3",
    "dompurify": "^3.4.17",
    "happy-dom": "21.0.4",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
